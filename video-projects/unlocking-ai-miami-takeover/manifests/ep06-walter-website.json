 "dialogue": [
  {
   "id": "L01",
   "speaker": "VIC",
   "text": "I specialize in bringing outdated spaces into the modern era.",
   "file": "audio/voices/ep06/EP06_L01_VIC_specialize.mp3"
  },
  {
   "id": "L02",
   "speaker": "NOELLE",
   "text": "You missed a spot.",
   "file": "audio/voices/ep06/EP06_L02_NOELLE_missed_spot.mp3"
  },
  {
   "id": "L03",
   "speaker": "VIC",
   "text": "Hey! I built that myself.",
   "file": "audio/voices/ep06/EP06_L03_VIC_built_it_myself.mp3"
  },
  {
   "id": "L04",
   "speaker": "NOELLE",
   "text": "I can tell.",
   "file": "audio/voices/ep06/EP06_L04_NOELLE_i_can_tell.mp3"
  },
  {
   "id": "L05",
   "speaker": "VIC",
   "text": "I'm a contractor, not a web designer.",
   "file": "audio/voices/ep06/EP06_L05_VIC_contractor.mp3"
  },
  {
   "id": "L06",
   "speaker": "NOELLE",
   "text": "Relax. I know a guy.",
   "file": "audio/voices/ep06/EP06_L06_NOELLE_know_a_guy.mp3"
  },
  {
   "id": "L07a",
   "speaker": "NOELLE",
   "text": "Meet Walter.",
   "file": "audio/voices/ep06/EP06_L07_NOELLE_meet_walter.mp3"
  },
  {
   "id": "L07b",
   "speaker": "NOELLE",
   "text": "Your AI website builder.",
   "file": "audio/voices/ep06/EP06_L07_NOELLE_meet_walter.mp3"
  },
  {
   "id": "L08",
   "speaker": "WALTER",
   "text": "Let's give your website the same attention to detail... you give your homes.",
   "file": "audio/voices/ep06/EP06_L08_WALTER_attention_to_detail.mp3"
  },
  {
   "id": "L09",
   "speaker": "VIC",
   "text": "Now THAT'S craftsmanship.",
   "file": "audio/voices/ep06/EP06_L09_VIC_craftsmanship.mp3"
  },
  {
   "id": "L10",
